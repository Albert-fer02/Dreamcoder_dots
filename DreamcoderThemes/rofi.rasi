/* Dreamcoder color layer for Rofi. */
* {
  background: rgba(13, 13, 17, 0.92);
  background-alt: #060608;
  foreground: #E2E8F0;
  muted: #94A3B8;
  selected: rgba(99, 102, 241, 0.28);
  active: #A5B4FC;
  border-ui: #68788F;
  focus: #3B82F6;
  urgent: #FB8585;
  border-color: #68788F;
}

window {
  background-color: @background;
  border: 1px;
  border-color: @border-ui;
  border-radius: 18px;
}

entry {
  background-color: @selected;
  text-color: @foreground;
  border: 1px;
  border-color: @focus;
  border-radius: 12px;
}

element selected {
  background-color: @selected;
  text-color: @foreground;
  border: 0 0 0 3px;
  border-color: @focus;
}

element-text { text-color: @muted; }
element selected element-text { text-color: @foreground; }
