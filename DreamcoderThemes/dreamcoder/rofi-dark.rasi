/* Dreamcoder color layer for Rofi. */
* {
  background: rgba(7, 10, 19, 0.80);
  background-alt: #0D121A;
  foreground: #E6EDF3;
  muted: #A8B5C2;
  selected: rgba(124, 179, 217, 0.24);
  active: #A5C7E8;
  border-ui: #647c8f;
  focus: #A5C7E8;
  urgent: #E69AA4;
  border-color: #647c8f;
}

window {
  background-color: @background;
  border: 1px;
  border-color: @border-ui;
  border-radius: 18px;
}

entry {
  background-color: @selected;
  text-color: @foreground;
  border: 1px;
  border-color: @focus;
  border-radius: 12px;
}

element selected {
  background-color: @selected;
  text-color: @foreground;
  border: 0 0 0 3px;
  border-color: @focus;
}

element-text { text-color: @muted; }
element selected element-text { text-color: @foreground; }
