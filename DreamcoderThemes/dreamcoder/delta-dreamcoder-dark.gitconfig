# ========================================================
# Dreamcoder Anthracite Steel — Git Delta theme
# ========================================================
# Include from ~/.config/git/config:
#   [include]
#       path = ~/.config/git/delta-dreamcoder.gitconfig

[delta]
    # Syntax highlighting theme for diff content
    syntax-theme = Dreamcoder-Dark

    # Line colors
    plus-color = "#387657"
    minus-color = "#86585c"
    plus-emph-color = "#55C080"
    minus-emph-color = "#E38989"

    # Diff UI
    file-style = "#A5C7E8"
    file-decoration-style = "bold yellow box ul"
    hunk-header-style = "file line-number syntax"
    hunk-header-decoration-style = "yellow box"
    hunk-header-file-style = "#A5C7E8"
    hunk-header-line-number-style = "#A8B5C2"
    hunk-header-color = "#757f8b"

    # Commit decorations
    commit-style = "#A5C7E8 bold"
    commit-decoration-style = "bold yellow box ul"

    # Line numbers
    line-numbers = true
    line-numbers-left-style = "#A8B5C2"
    line-numbers-right-style = "#A8B5C2"
    line-numbers-minus-style = "#E38989"
    line-numbers-plus-style = "#55C080"

    # Side-by-side
    side-by-side = true

    # Whitespace highlighting
    whitespace-error-style = "#E1C16D"

    # Navigation
    navigate = true
