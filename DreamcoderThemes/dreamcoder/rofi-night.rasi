/* Dreamcoder color layer for Rofi. */
* {
  background: rgba(7, 9, 15, 0.80);
  background-alt: #0d1015;
  foreground: #beccd8;
  muted: #8f9ca8;
  selected: rgba(104, 154, 190, 0.24);
  active: #95b5d5;
  border-ui: #6b7e8e;
  focus: #95b5d5;
  urgent: #d28c96;
  border-color: #6b7e8e;
}

window {
  background-color: @background;
  border: 1px;
  border-color: @border-ui;
  border-radius: 18px;
}

entry {
  background-color: @selected;
  text-color: @foreground;
  border: 1px;
  border-color: @focus;
  border-radius: 12px;
}

element selected {
  background-color: @selected;
  text-color: @foreground;
  border: 0 0 0 3px;
  border-color: @focus;
}

element-text { text-color: @muted; }
element selected element-text { text-color: @foreground; }
