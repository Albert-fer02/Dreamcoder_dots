/* Dreamcoder color layer for Rofi. */
* {
  background: rgba(12, 12, 14, 0.92);
  background-alt: #050507;
  foreground: #bcc7d5;
  muted: #8a96a7;
  selected: rgba(81, 84, 212, 0.28);
  active: #a4afee;
  border-ui: #6d7788;
  focus: #3a76d6;
  urgent: #e88484;
  border-color: #6d7788;
}

window {
  background-color: @background;
  border: 1px;
  border-color: @border-ui;
  border-radius: 18px;
}

entry {
  background-color: @selected;
  text-color: @foreground;
  border: 1px;
  border-color: @focus;
  border-radius: 12px;
}

element selected {
  background-color: @selected;
  text-color: @foreground;
  border: 0 0 0 3px;
  border-color: @focus;
}

element-text { text-color: @muted; }
element selected element-text { text-color: @foreground; }
