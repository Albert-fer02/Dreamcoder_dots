# ========================================================
# Dreamcoder Anthracite Steel — Cava theme
# ========================================================
# Include from ~/.config/cava/config or place in
# ~/.config/cava/dreamcoder-cava.config.

[color]
# Background
background = '#070A13'

# Gradient mode for smooth transitions
gradient = 1
gradient_count = 8

# Gradient colors (low to high frequency) — raw palette, muted at lower end
gradient_color_1 = '#364e62'
gradient_color_2 = '#4d6f8a'
gradient_color_3 = '#56687e'
gradient_color_4 = '#768ea8'
gradient_color_5 = '#A5C7E8'
gradient_color_6 = '#8FAFCB'
gradient_color_7 = '#a36f78'
gradient_color_8 = '#E69AA4'

# Mono color (used when gradient = 0)
foreground = '#A5C7E8'
