# ========================================================
# Dreamcoder Anthracite Steel Night — Git Delta theme
# ========================================================
# Include from ~/.config/git/config:
#   [include]
#       path = ~/.config/git/delta-dreamcoder.gitconfig

[delta]
    # Syntax highlighting theme for diff content
    syntax-theme = Dreamcoder-Night

    # Line colors
    plus-color = "#35624b"
    minus-color = "#7e585b"
    plus-emph-color = "#509e6f"
    minus-emph-color = "#d48d8d"

    # Diff UI
    file-style = "#95b5d5"
    file-decoration-style = "bold yellow box ul"
    hunk-header-style = "file line-number syntax"
    hunk-header-decoration-style = "yellow box"
    hunk-header-file-style = "#95b5d5"
    hunk-header-line-number-style = "#8f9ca8"
    hunk-header-color = "#646e78"

    # Commit decorations
    commit-style = "#95b5d5 bold"
    commit-decoration-style = "bold yellow box ul"

    # Line numbers
    line-numbers = true
    line-numbers-left-style = "#8f9ca8"
    line-numbers-right-style = "#8f9ca8"
    line-numbers-minus-style = "#d48d8d"
    line-numbers-plus-style = "#509e6f"

    # Side-by-side
    side-by-side = true

    # Whitespace highlighting
    whitespace-error-style = "#c4a75b"

    # Navigation
    navigate = true
