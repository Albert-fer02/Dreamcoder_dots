# ========================================================
# Dreamcoder Dark Black OLED Night — Git Delta theme
# ========================================================
# Include from ~/.config/git/config:
#   [include]
#       path = ~/.config/git/delta-dreamcoder.gitconfig

[delta]
    # Syntax highlighting theme for diff content
    syntax-theme = Dreamcoder-Night

    # Line colors
    plus-color = "#2a6853"
    minus-color = "#854e4f"
    plus-emph-color = "#43b48b"
    minus-emph-color = "#e88484"

    # Diff UI
    file-style = "#a4afee"
    file-decoration-style = "bold yellow box ul"
    hunk-header-style = "file line-number syntax"
    hunk-header-decoration-style = "yellow box"
    hunk-header-file-style = "#a4afee"
    hunk-header-line-number-style = "#8a96a7"
    hunk-header-color = "#5e6671"

    # Commit decorations
    commit-style = "#a4afee bold"
    commit-decoration-style = "bold yellow box ul"

    # Line numbers
    line-numbers = true
    line-numbers-left-style = "#8a96a7"
    line-numbers-right-style = "#8a96a7"
    line-numbers-minus-style = "#e88484"
    line-numbers-plus-style = "#43b48b"

    # Side-by-side
    side-by-side = true

    # Whitespace highlighting
    whitespace-error-style = "#d1a126"

    # Navigation
    navigate = true
