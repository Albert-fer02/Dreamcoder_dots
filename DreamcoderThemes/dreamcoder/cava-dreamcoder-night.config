# ========================================================
# Dreamcoder Anthracite Steel Night — Cava theme
# ========================================================
# Include from ~/.config/cava/config or place in
# ~/.config/cava/dreamcoder-cava.config.

[color]
# Background
background = '#07090f'

# Gradient mode for smooth transitions
gradient = 1
gradient_count = 8

# Gradient colors (low to high frequency) — raw palette, muted at lower end
gradient_color_1 = '#2d4958'
gradient_color_2 = '#406a7d'
gradient_color_3 = '#4e5f72'
gradient_color_4 = '#6a819a'
gradient_color_5 = '#95b5d5'
gradient_color_6 = '#7997b1'
gradient_color_7 = '#95656e'
gradient_color_8 = '#d28c96'

# Mono color (used when gradient = 0)
foreground = '#95b5d5'
