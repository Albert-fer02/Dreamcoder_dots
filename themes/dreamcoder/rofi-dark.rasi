/* Dreamcoder color layer for Rofi. */
* {
  background: rgba(18, 16, 14, 0.76);
  background-alt: #211c18;
  foreground: #e8dfd0;
  muted: #c7b9aa;
  selected: rgba(217, 149, 85, 0.24);
  active: #d99555;
  border-ui: #968878;
  focus: #d99555;
  urgent: #e98272;
  border-color: #968878;
}

window {
  background-color: @background;
  border: 1px;
  border-color: @border-ui;
  border-radius: 18px;
}

entry {
  background-color: @selected;
  text-color: @foreground;
  border: 1px;
  border-color: @focus;
  border-radius: 12px;
}

element selected {
  background-color: @selected;
  text-color: @foreground;
  border: 0 0 0 3px;
  border-color: @focus;
}

element-text { text-color: @muted; }
element selected element-text { text-color: @foreground; }
