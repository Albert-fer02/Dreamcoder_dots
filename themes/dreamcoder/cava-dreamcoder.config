# ========================================================
# Dreamcoder Ember Noir OLED — Cava theme
# ========================================================
# Include from ~/.config/cava/config or place in
# ~/.config/cava/dreamcoder-cava.config.

[color]
# Background
background = '#12100e'

# Gradient mode for smooth transitions
gradient = 1
gradient_count = 8

# Gradient colors (low to high frequency) — raw palette, muted at lower end
gradient_color_1 = '#314559'
gradient_color_2 = '#40607f'
gradient_color_3 = '#765232'
gradient_color_4 = '#9d6d40'
gradient_color_5 = '#d99555'
gradient_color_6 = '#c96a45'
gradient_color_7 = '#a86054'
gradient_color_8 = '#e98272'

# Mono color (used when gradient = 0)
foreground = '#d99555'
