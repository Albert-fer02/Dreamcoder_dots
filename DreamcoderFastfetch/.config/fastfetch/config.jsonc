// =====================================================
// 🧩 CONFIGURACIÓN PRINCIPAL DE FASTFETCH
// =====================================================
// Configuración base con soporte para assets separados
// =====================================================

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/dreamcoder/Dreamcoder01.jpg",
    "type": "kitty",
    "recache": true,
    "height": 14,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 1,
    },
  },
  "display": {
    "separator": " ",
  },
  "modules": [
    {
      "key": "╭───────────╮",
      "type": "custom",
    },
    {
      "key": "│ {#d99555} user    {#keys}│",
      "type": "title",
      "format": "{user-name}",
    },
    {
      "key": "│ {#5f8f8f}󰇅 hname   {#keys}│",
      "type": "title",
      "format": "{host-name}",
    },
    {
      "key": "│ {#8fa074}󰅐 uptime  {#keys}│",
      "type": "uptime",
    },
    {
      "key": "│ {#5f95ca}{icon} distro  {#keys}│",
      "type": "os",
    },
    {
      "key": "│ {#938274} kernel  {#keys}│",
      "type": "kernel",
    },
    {
      "key": "│ {#5f8f8f}󰇄 desktop {#keys}│",
      "type": "de",
    },
    {
      "key": "│ {#d99555} term    {#keys}│",
      "type": "terminal",
    },
    {
      "key": "│ {#8fa074} shell   {#keys}│",
      "type": "shell",
    },
    {
      "key": "│ {#d99555}󰍛 cpu     {#keys}│",
      "type": "cpu",
      "showPeCoreCount": true,
    },
    {
      "key": "│ {#5f95ca}󰉉 disk    {#keys}│",
      "type": "disk",
      "folders": ["/"],
    },
    {
      "key": "│ {#938274} memory  {#keys}│",
      "type": "memory",
    },
    {
      "key": "│ {#5f8f8f}󰩟 network {#keys}│",
      "type": "localip",
      "format": "{ipv4} ({ifname})",
    },
    {
      "key": "├───────────┤",
      "type": "custom",
    },
    {
      "key": "│ {#b8a44a} colors  {#keys}│",
      "type": "colors",
      "symbol": "circle",
    },
    {
      "key": "╰───────────╯",
      "type": "custom",
    },
  ],
}
