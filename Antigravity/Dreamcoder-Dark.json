{
  "name": "Dreamcoder Ember Noir OLED",
  "type": "light",
  "colors": {
    "editor.background": "#12100e",
    "editor.foreground": "#e8dfd0",
    "activityBar.background": "#211c18",
    "activityBar.foreground": "#d99555",
    "activityBar.inactiveForeground": "#b8a99a",
    "activityBar.border": "#908070",
    "sideBar.background": "#211c18",
    "sideBar.foreground": "#e8dfd0",
    "sideBar.border": "#908070",
    "statusBar.background": "#12100e",
    "statusBar.foreground": "#e8dfd0",
    "statusBar.border": "#908070",
    "editorGroupHeader.tabsBackground": "#211c18",
    "tab.activeBackground": "#12100e",
    "tab.activeForeground": "#d99555",
    "tab.inactiveBackground": "#211c18",
    "tab.inactiveForeground": "#b8a99a",
    "tab.border": "#908070",
    "editor.lineHighlightBackground": "#211c18",
    "editorLineNumber.foreground": "#b8a99a",
    "editorLineNumber.activeForeground": "#d99555",
    "editorWidget.background": "#2e241f",
    "editorWidget.border": "#908070",
    "input.background": "#2e241f",
    "input.foreground": "#e8dfd0",
    "input.border": "#d99555",
    "button.background": "#c96a45",
    "button.foreground": "#e8dfd0",
    "list.activeSelectionBackground": "#2e241f",
    "list.activeSelectionForeground": "#e8dfd0",
    "list.hoverBackground": "#211c18",
    "editor.selectionBackground": "#2e241f",
    "terminal.background": "#12100e",
    "terminal.foreground": "#e8dfd0",
    "terminal.ansiBlack": "#211c18",
    "terminal.ansiRed": "#e98272",
    "terminal.ansiGreen": "#45a055",
    "terminal.ansiYellow": "#e8b866",
    "terminal.ansiBlue": "#d99555",
    "terminal.ansiMagenta": "#d98aa9",
    "terminal.ansiCyan": "#5f95ca",
    "terminal.ansiWhite": "#e8dfd0"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#b8a99a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#d99555",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#5f95ca"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#45a055"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#c96a45"
      }
    },
    {
      "scope": [
        "support.type",
        "entity.name.type",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#c9a8dc"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#e8dfd0"
      }
    }
  ]
}