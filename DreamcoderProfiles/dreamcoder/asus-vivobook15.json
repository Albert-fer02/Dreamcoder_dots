{
  "name": "asus-vivobook15",
  "description": "Dreamcoder tuned profile for ASUS VivoBook 15 FHD laptop panels.",
  "monitor": "eDP-1,1920x1080@60,0x0,1",
  "monitor_scale": 1,
  "keyboard_layout": "latam",
  "repeat_rate": 50,
  "repeat_delay": 250,
  "shell": "fish --login",
  "terminal_default_mode": "light",
  "motion_preset": "fluid",
  "performance_notes": "Optimized for responsive typing, FHD readability, light default mode, and laptop-friendly motion.",
  "keybindings": {
    "super_mod": "SUPER",
    "bindings": [
      {
        "key": "RETURN",
        "mods": [
          "SUPER"
        ],
        "command": "kitty",
        "description": "Terminal"
      },
      {
        "key": "B",
        "mods": [
          "SUPER"
        ],
        "command": "firefox",
        "description": "Browser"
      },
      {
        "key": "E",
        "mods": [
          "SUPER"
        ],
        "command": "thunar",
        "description": "File Manager"
      },
      {
        "key": "SPACE",
        "mods": [
          "SUPER"
        ],
        "command": "rofi -show drun",
        "description": "Application Launcher"
      },
      {
        "key": "V",
        "mods": [
          "SUPER"
        ],
        "command": "cliphist list | rofi -dmenu | cliphist decode | wl-copy",
        "description": "Clipboard Manager"
      },
      {
        "key": "K",
        "mods": [
          "SUPER",
          "CTRL",
          "SHIFT"
        ],
        "command": "kitty nvim",
        "description": "Code Editor (Neovim)"
      },
      {
        "key": "M",
        "mods": [
          "SUPER",
          "CTRL"
        ],
        "command": "kitty btop",
        "description": "System Monitor (btop)"
      },
      {
        "key": "S",
        "mods": [
          "SUPER",
          "CTRL"
        ],
        "command": "flatpak run com.ml4w.settings",
        "description": "ML4W Settings"
      },
      {
        "key": "C",
        "mods": [
          "SUPER",
          "CTRL"
        ],
        "command": "~/.config/ml4w/settings/calculator.sh",
        "description": "Calculator"
      },
      {
        "key": "Q",
        "mods": [
          "SUPER"
        ],
        "command": "hyprctl dispatch killactive",
        "description": "Close Window"
      },
      {
        "key": "F",
        "mods": [
          "SUPER"
        ],
        "command": "hyprctl dispatch fullscreen 1",
        "description": "Toggle Fullscreen"
      },
      {
        "key": "T",
        "mods": [
          "SUPER"
        ],
        "command": "hyprctl dispatch togglefloating",
        "description": "Toggle Floating Window"
      },
      {
        "key": "Y",
        "mods": [
          "SUPER"
        ],
        "command": "hyprctl dispatch togglesplit",
        "description": "Toggle Split Direction"
      },
      {
        "key": "1",
        "mods": [
          "SUPER"
        ],
        "command": "hyprctl dispatch workspace 1",
        "description": "Workspace 1"
      },
      {
        "key": "2",
        "mods": [
          "SUPER"
        ],
        "command": "hyprctl dispatch workspace 2",
