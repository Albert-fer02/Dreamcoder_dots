{
  "name": "default",
  "description": "Portable Dreamcoder defaults for unknown machines.",
  "monitor": "auto",
  "monitor_scale": 1,
  "keyboard_layout": "latam",
  "repeat_rate": 40,
  "repeat_delay": 300,
  "shell": "fish --login",
  "terminal_default_mode": "light",
  "motion_preset": "balanced",
  "performance_notes": "Safe defaults with moderate key repeat and low visual overhead.",
  "keybindings": {
    "super_mod": "SUPER",
    "bindings": [
      {
        "key": "RETURN",
        "mods": [
          "SUPER"
        ],
        "command": "kitty",
        "description": "Terminal"
      },
      {
        "key": "B",
        "mods": [
          "SUPER"
        ],
        "command": "firefox",
        "description": "Browser"
      },
      {
        "key": "E",
        "mods": [
          "SUPER"
        ],
        "command": "thunar",
        "description": "File Manager"
      },
      {
        "key": "SPACE",
        "mods": [
          "SUPER"
        ],
        "command": "rofi -show drun",
        "description": "Application Launcher"
      },
      {
        "key": "V",
        "mods": [
          "SUPER"
        ],
        "command": "cliphist list | rofi -dmenu | cliphist decode | wl-copy",
        "description": "Clipboard Manager"
      },
      {
        "key": "K",
        "mods": [
          "SUPER",
          "CTRL",
          "SHIFT"
        ],
        "command": "kitty nvim",
        "description": "Code Editor (Neovim)"
      },
      {
        "key": "M",
        "mods": [
          "SUPER",
          "CTRL"
