{
  "name": "Dreamcoder Anthracite Steel",
  "type": "dark",
  "colors": {
    "editor.background": "#070A13",
    "editor.foreground": "#E6EDF3",
    "activityBar.background": "#0D121A",
    "activityBar.foreground": "#A5C7E8",
    "activityBar.inactiveForeground": "#aab7c4",
    "activityBar.border": "#647c8f",
    "sideBar.background": "#0D121A",
    "sideBar.foreground": "#E6EDF3",
    "sideBar.border": "#647c8f",
    "statusBar.background": "#070A13",
    "statusBar.foreground": "#E6EDF3",
    "statusBar.border": "#647c8f",
    "editorGroupHeader.tabsBackground": "#0D121A",
    "tab.activeBackground": "#070A13",
    "tab.activeForeground": "#A5C7E8",
    "tab.inactiveBackground": "#0D121A",
    "tab.inactiveForeground": "#aab7c4",
    "tab.border": "#647c8f",
    "editor.lineHighlightBackground": "#0D121A",
    "editorLineNumber.foreground": "#aab7c4",
    "editorLineNumber.activeForeground": "#A5C7E8",
    "editorWidget.background": "#151C25",
    "editorWidget.border": "#647c8f",
    "input.background": "#151C25",
    "input.foreground": "#E6EDF3",
    "input.border": "#A5C7E8",
    "button.background": "#8FAFCB",
    "button.foreground": "#E6EDF3",
    "list.activeSelectionBackground": "#151C25",
    "list.activeSelectionForeground": "#E6EDF3",
    "list.hoverBackground": "#0D121A",
    "editor.selectionBackground": "#151C25",
    "terminal.background": "#070A13",
    "terminal.foreground": "#E6EDF3",
    "terminal.ansiBlack": "#0D121A",
    "terminal.ansiRed": "#E38989",
    "terminal.ansiGreen": "#55C080",
    "terminal.ansiYellow": "#E1C16D",
    "terminal.ansiBlue": "#A5C7E8",
    "terminal.ansiMagenta": "#B48EAD",
    "terminal.ansiCyan": "#4DAED6",
    "terminal.ansiWhite": "#E6EDF3"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#aab7c4",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#A5C7E8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#4DAED6"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#55C080"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#8FAFCB"
      }
    },
    {
      "scope": [
        "support.type",
        "entity.name.type",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#B6C5D4"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#E6EDF3"
      }
    }
  ]
}
